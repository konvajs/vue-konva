{
  "name": "vue-konva",
  "version": "4.0.0",
  "description": "Vue binding to canvas element via Konva framework",
  "keywords": [
    "vue",
    "konva",
    "canvas"
  ],
  "homepage": "https://github.com/konvajs/vue-konva#readme",
  "author": "Rafael Escala <rafaesc92@gmail.com>",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/vue-konva.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/vue-konva.js"
    },
    "./core": {
      "types": "./dist/index-core.d.ts",
      "default": "./dist/vue-konva-core.js"
    }
  },
  "unpkg": "./dist/vue-konva.umd.js",
  "jsdelivr": "./dist/vue-konva.umd.js",
  "sideEffects": false,
  "vetur": {
    "tags": "vetur/tags.json",
    "attributes": "vetur/attributes.json"
  },
  "files": [
    "dist/",
    "vetur/"
  ],
  "funding": [
    {
      "type": "patreon",
      "url": "https://www.patreon.com/lavrton"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/konva"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/lavrton"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konvajs/vue-konva.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/konvajs/vue-konva/issues"
  },
  "scripts": {
    "build": "vite build && BUILD_CORE=1 vite build && tsc -p tsconfig.build.json",
    "test": "vitest",
    "check:package": "node scripts/check-dist.mjs && attw --pack . --profile esm-only && publint",
    "prepublishOnly": "npm run build && npm run check:package"
  },
  "peerDependencies": {
    "konva": ">7",
    "vue": "^3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.4.0",
    "@vue/test-utils": "^2.5.0",
    "canvas": "^3.2.3",
    "jsdom": "^30.0.1",
    "konva": "^10.3.2",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.42"
  },
  "engines": {
    "node": ">=18"
  }
}
